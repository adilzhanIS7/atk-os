<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AtkOs.App.ViewModels"
        x:Class="AtkOs.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ATK-OS"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#131416">

  <StackPanel Margin="14" Spacing="10">

    <!-- Header: model, link, battery -->
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding ModelName}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Details}" Foreground="#9DA3AE" FontSize="12"
                     IsVisible="{Binding IsConnected}" />
          <TextBlock Text="{Binding Status}" Foreground="#9DA3AE" FontSize="12"
                     IsVisible="{Binding !IsConnected}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding BatteryText}" FontSize="22" FontWeight="Bold"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <StackPanel Spacing="10" IsEnabled="{Binding IsConnected}">

      <!-- DPI -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="title" Text="DPI" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Levels" Foreground="#9DA3AE" VerticalAlignment="Center" FontSize="12" />
              <NumericUpDown Value="{Binding SlotCount}" Minimum="1" Maximum="8" Increment="1"
                             FormatString="0" Width="110" />
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding DpiSlots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DpiSlotViewModel">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2">
                  <RadioButton GroupName="dpi" IsChecked="{Binding IsActive}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="swatch" Margin="0,0,10,0" VerticalAlignment="Center"
                          ToolTip.Tip="DPI indicator color"
                          AutomationProperties.Name="{Binding Label, StringFormat='Color of {0}'}">
                    <Ellipse Width="14" Height="14" Fill="{Binding Color}" />
                    <Button.Flyout>
                      <Flyout Placement="Bottom">
                        <StackPanel Spacing="8" Width="200">
                          <ItemsControl ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ColorSwatch">
                                <Button Classes="swatch" Command="{Binding Command}" Margin="3"
                                        AutomationProperties.Name="{Binding Hex}" ToolTip.Tip="{Binding Hex}">
                                  <Ellipse Width="24" Height="24" Fill="{Binding Brush}" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding Hex}" Watermark="#RRGGBB" MaxLength="7" />
                            <Button Grid.Column="1" Content="Set" Margin="6,0,0,0" Command="{Binding ApplyHexCommand}" />
                          </Grid>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="3" Width="150" FormatString="0"
                                 Value="{Binding Dpi}"
                                 Minimum="50"
                                 Maximum="{Binding $parent[Window].((vm:MainViewModel)DataContext).MaxDpi}"
                                 Increment="{Binding $parent[Window].((vm:MainViewModel)DataContext).DpiStep}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Polling rate -->
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="title" Text="Polling rate, Hz" />
          <ListBox Classes="segmented" ItemsSource="{Binding ReportRates}" SelectedItem="{Binding SelectedRate}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RateOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Sensor -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="Sensor" />

          <Grid ColumnDefinitions="*,200">
            <TextBlock Text="Lift-off distance" VerticalAlignment="Center" />
            <ListBox Grid.Column="1" Classes="segmented" ItemsSource="{Binding LodOptions}"
                     SelectedItem="{Binding SelectedLod}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LodOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Grid ColumnDefinitions="*,200">
            <TextBlock Text="Button debounce" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding DebounceOptions}" SelectedItem="{Binding SelectedDebounce}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DebounceOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Motion sync" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Motion sync" IsChecked="{Binding MotionSync}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Angle snapping" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Angle snapping" IsChecked="{Binding AngleSnapping}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Ripple control" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Ripple control" IsChecked="{Binding RippleControl}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- App settings: available even without a mouse -->
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="title" Text="App" />
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutostartSupported}">
          <TextBlock Text="Start with system (in tray)" VerticalAlignment="Center" />
          <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Start with system" IsChecked="{Binding StartWithSystem}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding LowBatteryLabel}" VerticalAlignment="Center" />
          <ToggleSwitch Grid.Column="1" AutomationProperties.Name="Low battery alert" IsChecked="{Binding LowBatteryAlert}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding AppVersion}" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="GitHub" Click="OpenProjectPage" Padding="10,3" FontSize="12"
                  Background="Transparent" Foreground="#7EA6F5" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Status}" Foreground="#6B7280" FontSize="11"
               IsVisible="{Binding IsConnected}" HorizontalAlignment="Center" />
  </StackPanel>
</Window>
